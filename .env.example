DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used only by `npm run db:seed` to create the first admin account
SEED_ADMIN_EMAIL="you@gmail.com"
SEED_ADMIN_PASSWORD="change-me"

# Used to email account-invite links (Gmail SMTP, sent from your own Gmail address).
# See README.md "Sending invite emails" for how to generate an App Password.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="16-character-app-password"
